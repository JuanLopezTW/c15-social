# Postgres propio del servicio (usuarios y partidas_jugadas)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=c15_social
DB_USERNAME=cambiar_usuario
DB_PASSWORD=cambiar_clave

# Proveedor de identidad (no son secretos)
AUTH0_ISSUER=https://escaperoomc15.us.auth0.com/
AUTH0_AUDIENCE=https://api.escaperoomc15

# Eventos entre servicios
EVENTOS_KAFKA=true
KAFKA_SERVIDORES=localhost:9092

# Lo que se publica en los topics STOMP sale por RabbitMQ hacia el broker
STOMP_RELAY=true
STOMP_HOST=localhost
STOMP_USUARIO=cambiar_usuario
STOMP_CLAVE=cambiar_clave

# Estado del chat compartido entre replicas
ESTADO_REDIS=false
REDIS_HOST=localhost
REDIS_CLAVE=cambiar_clave

# El chat de la sala de espera le pregunta a salas
SALAS_URL=http://localhost:8082
